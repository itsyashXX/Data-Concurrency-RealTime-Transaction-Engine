# DataCore Environment Configuration Template
# Copy this file to .env for local development

# ==========================================
# Django Core Settings
# ==========================================
DJANGO_SECRET_KEY=change-me-in-production-random-secret-key-64-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# ==========================================
# Database Configuration
# ==========================================
# For local SQLite development (leave empty or unset):
# DATABASE_URL=
# For PostgreSQL (e.g., Render Managed Postgres or local Docker):
DATABASE_URL=postgres://datacore_user:datacore_password@localhost:5432/datacore_db

# ==========================================
# CORS Configuration
# ==========================================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://datacore-admin.vercel.app

# ==========================================
# Security & Performance
# ==========================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ==========================================
# Application Defaults
# ==========================================
DEFAULT_INITIAL_BALANCE=10000.00
DEFAULT_CURRENCY=INR
