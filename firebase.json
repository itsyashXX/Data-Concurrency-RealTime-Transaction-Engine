{
  "hosting": {
    "public": "admin-dashboard/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/preview.html",
        "destination": "/preview.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}